<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFF8F0"
                android:centerColor="#FFF0F7"
                android:endColor="#F1EAFF"/>
        </shape>
    </item>

    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="top|start"
        android:left="0dp"
        android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="#66FFD6E7"/>
        </shape>
    </item>

    <item
        android:width="110dp"
        android:height="110dp"
        android:gravity="top|end"
        android:top="40dp"
        android:right="20dp">
        <shape android:shape="oval">
            <solid android:color="#66CFE8FF"/>
        </shape>
    </item>

    <item
        android:width="130dp"
        android:height="130dp"
        android:gravity="bottom|start"
        android:left="10dp"
        android:bottom="60dp">
        <shape android:shape="oval">
            <solid android:color="#66FFF3B0"/>
        </shape>
    </item>

    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="bottom|end"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#66E3D5FF"/>
        </shape>
    </item>

</layer-list>
